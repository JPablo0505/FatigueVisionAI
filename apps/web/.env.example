# URL base de la API del backend.
# Vacío = mismo origen (usa el proxy de desarrollo de Vite hacia http://127.0.0.1:8000).
# Ejemplo: VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_API_BASE_URL=

# URL directa del WebSocket del backend (S3-02).
# Vacío = ws://<hostname>:8000/ws (conexión directa, bypass Vite proxy).
# El proxy de Vite se eliminó para /ws porque colapsaba con alto volumen
# de frames (ECONNABORTED). Solo queda el proxy de /api.
# Ejemplo: VITE_WS_URL=ws://127.0.0.1:8000/ws
# VITE_WS_URL=