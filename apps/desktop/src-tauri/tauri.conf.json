{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FatigueVision AI",
  "version": "0.1.0",
  "identifier": "com.fatiguevision.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @fatiguevision/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @fatiguevision/web build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fatigue Vision AI",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}